# Firebase Auth (client-side, optional — Demo Mode works without these)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-side Gemini AI (required for AI features)
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# Google Fit OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match Authorized Redirect URI in Google Cloud Console exactly:
# Local development: http://localhost:3005/auth/google/callback (or backend port)
# Production / Vercel: https://<your-project>.vercel.app/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback

# Frontend & Application URL
# Local development: http://localhost:5173
# Production / Vercel: https://<your-project>.vercel.app
FRONTEND_URL=http://localhost:5173

# Database & Token Storage
# MongoDB connection URI (e.g. MongoDB Atlas cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthscan?retryWrites=true&w=majority
# 32-byte hex key for encrypting stored Google Fit tokens at rest (64 hex characters)
TOKEN_ENCRYPTION_KEY=generate_a_64_hex_character_key_here

# Server Security & Sessions
# Must be set and kept secret (minimum 32 characters, no fallback in production)
JWT_SECRET=generate_a_strong_jwt_secret_here
SESSION_SECRET=generate_a_strong_random_string_here
NODE_ENV=development
ENABLE_DEMO_AUTH=false
ENABLE_DEMO_DATA=false
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
